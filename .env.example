# Obligatoria
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/landing

# Dominio(s) del frontend que pueden enviar el formulario, separados por coma
ALLOWED_ORIGIN=http://localhost:5500

# Panel de admin (si falta alguna, /admin responde 503)
ADMIN_USER=
# Generar con: npm run hash-password
ADMIN_PASSWORD_HASH=
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Aviso por correo de cada lead (opcional; Gmail requiere contraseña de aplicación)
EMAIL_USER=
EMAIL_PASS=
NOTIFY_EMAIL=

NODE_ENV=development
